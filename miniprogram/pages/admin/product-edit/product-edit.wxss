/* 新增/编辑配件 样式 */
.edit-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
}

/* 区块卡片 */
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title-row .section-title {
  margin-bottom: 0;
}

.field {
  margin-bottom: 28rpx;
}
.field:last-child {
  margin-bottom: 0;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.req { color: #E53E3E; }

.input {
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}
.ph, .ph-text { color: #bbb; }

/* picker */
.picker {
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
}
.arrow { color: #bbb; }

/* textarea */
.textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}
.textarea.desc {
  min-height: 200rpx;
}

/* 状态单选 */
.radio-row {
  display: flex;
}
.radio {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
  margin-right: 40rpx;
}
.radio text {
  margin-right: 8rpx;
  font-size: 28rpx;
  color: #c8cdd6;
}
.radio.checked text {
  color: #2B99FF;
}
.radio.checked {
  color: #2B99FF;
}

/* 新增行按钮 */
.add-btn {
  color: #2B99FF;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid #2B99FF;
  border-radius: 32rpx;
}

/* ===== 图片上传 ===== */
/* 主图展示区 */
.main-image-box {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.main-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.main-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F7FA;
  color: #bbb;
  font-size: 24rpx;
}
.main-upload-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: #2B99FF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
}
.main-upload-btn[disabled] { opacity: 0.6; }

/* 展示图网格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
}
.img-cell {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin: 0 16rpx 16rpx 0;
}
.img-preview {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #F5F7FA;
}
.img-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: #E53E3E;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  z-index: 2;
}
.img-main-tag {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 12rpx;
  background: rgba(43, 153, 255, 0.9);
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
}
.img-add {
  width: 176rpx;
  height: 176rpx;
  border: 2rpx dashed #c8cdd6;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}
.img-add-plus {
  font-size: 56rpx;
  line-height: 60rpx;
}
.img-add-text {
  font-size: 22rpx;
}
.muted {
  color: #999;
  font-size: 22rpx;
}

/* 规格动态行 */
.spec-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.spec-input {
  flex: 1;
  height: 76rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
}
.sep {
  color: #bbb;
  margin-right: 12rpx;
}
.del {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  color: #E53E3E;
  border: 2rpx solid #E53E3E;
  border-radius: 50%;
  font-size: 28rpx;
}
.spec-empty {
  font-size: 24rpx;
  color: #bbb;
  padding: 8rpx 0;
}

/* 适配车型 */
.vehicle-group {
  margin-bottom: 16rpx;
}
.vg-brand {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.vg-models {
  display: flex;
  flex-wrap: wrap;
}
.model-check {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-right: 24rpx;
  margin-bottom: 8rpx;
}
.model-check checkbox {
  margin-right: 4rpx;
  transform: scale(0.7);
}

/* 保存按钮 */
.save-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: #2B99FF;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
}
.save-btn[disabled] { opacity: 0.6; }
.bottom-space {
  height: 24rpx;
}