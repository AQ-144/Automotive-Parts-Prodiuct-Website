/* 后台登录页样式 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2B99FF 0%, #6bb8ff 45%, #F5F7FA 100%);
  padding: 32rpx;
}

/* 顶部品牌区 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}
.logo {
  width: 128rpx;
  height: 128rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

/* 登录卡片 */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}
.input-group {
  margin-bottom: 40rpx;
}
.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}
.input {
  height: 88rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
}
.ph {
  color: #bbb;
}
.tip {
  font-size: 24rpx;
  color: #8a8f9b;
  margin-top: 16rpx;
}

.login-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #2B99FF;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
}
.login-btn[disabled] {
  opacity: 0.6;
}