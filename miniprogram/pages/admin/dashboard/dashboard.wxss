/* 后台首页 (仪表盘) 样式 */
.dash-page {
  min-height: 100vh;
  padding: 32rpx;
}

/* 顶部欢迎横幅 */
.banner {
  background: linear-gradient(135deg, #2B99FF 0%, #6bb8ff 100%);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  color: #fff;
  margin-bottom: 32rpx;
}
.hi {
  font-size: 40rpx;
  font-weight: 700;
}
.sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

/* 统计卡片 两列 Grid */
.stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.stat-card {
  width: 48%;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.stat-val {
  font-size: 52rpx;
  font-weight: 700;
  color: #2B99FF;
}
.stat-val.on-sale { color: #00B386; }
.stat-val.off-shelf { color: #E53E3E; }
.stat-val.sales { color: #FF7D00; }
.stat-label {
  font-size: 26rpx;
  color: #8a8f9b;
  margin-top: 8rpx;
}

/* 功能入口 */
.quick {
  margin-top: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}
.entry-grid {
  display: flex;
  justify-content: space-between;
}
.entry {
  width: 31%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.entry-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  font-size: 40rpx;
  color: #fff;
  text-align: center;
}
.entry-icon.add { background: #2B99FF; }
.entry-icon.list { background: #FF7D00; }
.entry-icon.out { background: #E53E3E; }
.entry-text {
  font-size: 26rpx;
  color: #333;
}