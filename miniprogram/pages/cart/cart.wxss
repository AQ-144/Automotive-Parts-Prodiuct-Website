/* 询价单样式 */
/* 设计规范：主色 #2B99FF | 辅助 #FF7D00 | 强调 #E53E3E | 背景 #F5F7FA | 文字 #333 */
/* 圆角 24rpx | 间距 32rpx（1rpx≈0.5px） */
.page {
  padding: 24rpx 24rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ===== 列表卡片（单列） ===== */
.cart-list {
  display: flex;
  flex-direction: column;
}
.cart-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.cart-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f0f2f5;
  flex-shrink: 0;
}
.cart-info {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
}
.cart-name {
  font-size: 28rpx;
  color: #333;
  line-height: 38rpx;
  height: 76rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  margin-bottom: 12rpx;
}
.cart-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF7D00;
}
.cart-price .sign {
  font-size: 22rpx;
}
.cart-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  color: #2B99FF;
  background: #EAF4FF;
  border-radius: 12rpx;
}
.step-btn.step-disabled {
  color: #c5c9d0;
  background: #f2f3f5;
}
.step-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}
.btn-hover { opacity: 0.85; }

/* 删除 */
.del-btn {
  font-size: 24rpx;
  color: #E53E3E;
  padding: 4rpx 12rpx;
}

/* ===== 底部操作栏 ===== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}
.footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.clear-all {
  font-size: 26rpx;
  color: #8a8f9b;
}
.total-wrap {
  display: flex;
  align-items: baseline;
}
.total-label {
  font-size: 28rpx;
  color: #333;
}
.total-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #E53E3E;
}
.total-num .sign {
  font-size: 26rpx;
  margin-right: 4rpx;
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: #2B99FF;
  border-radius: 44rpx;
  border: none;
}
.submit-btn::after { border: none; }
.submit-hover { opacity: 0.9; }

/* ===== 空态 ===== */
.empty {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a0a6b2;
}
.go-buy {
  margin-top: 40rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #fff;
  background: #2B99FF;
  border-radius: 40rpx;
}