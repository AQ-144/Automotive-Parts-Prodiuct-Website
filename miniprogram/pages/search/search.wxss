/* 搜索页样式 */
/* 设计规范：主色 #2B99FF | 辅助 #FF7D00 | 背景 #F5F7FA | 文字 #333 */
/* 圆角 24rpx | 间距 32rpx（1rpx≈0.5px） */
.page {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* ===== 顶部搜索框 ===== */
.search-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.search-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #333;
}
.search-ph {
  color: #a0a6b2;
}
.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
  background: #c5c9d0;
  border-radius: 50%;
}
.search-btn {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #2B99FF;
  border-radius: 36rpx;
}
.btn-hover { opacity: 0.85; }

/* ===== 通用版块 ===== */
.sec {
  margin-top: 24rpx;
}
.sec-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.sec-clear {
  font-size: 24rpx;
  color: #8a8f9b;
}

/* 关键词标签 */
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
}
.tag {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #555;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.tag-hot {
  color: #fff;
  background: #2B99FF;
}

/* 分类快捷入口 */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
}
.cat-card {
  width: calc((100% - 24rpx) / 2);
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}
.cat-card:nth-child(odd) {
  margin-right: 24rpx;
}
.cat-emoji {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

/* ===== 搜索结果 ===== */
.result-hint {
  font-size: 24rpx;
  color: #8a8f9b;
  margin-bottom: 20rpx;
}
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.goods-card {
  width: calc((100% - 24rpx) / 2);
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.card-hover { opacity: 0.9; }
.img-wrap {
  position: relative;
}
.goods-img {
  width: 100%;
  height: 344rpx;
  background: #f0f2f5;
  display: block;
}
.cat-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #fff;
  border-radius: 20rpx;
}
.goods-name {
  padding: 16rpx 20rpx 0;
  font-size: 26rpx;
  color: #333;
  line-height: 36rpx;
  height: 72rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.goods-price {
  padding: 12rpx 20rpx 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #FF7D00;
}
.goods-price .sign {
  font-size: 24rpx;
}
.goods-oem {
  padding: 6rpx 20rpx 20rpx;
  font-size: 22rpx;
  color: #a0a6b2;
}

/* ===== 空态 ===== */
.empty {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a0a6b2;
}