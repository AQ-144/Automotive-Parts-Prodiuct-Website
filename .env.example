# ==================== 运行环境 ====================
NODE_ENV=development
PORT=3000
# 部署在 Nginx/负载均衡后置为 1，限流才能获取真实客户端 IP
TRUST_PROXY=0

# ==================== 管理员账号 ====================
# 二选一：生产环境建议只配置 bcrypt 哈希，不保留明文密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Dev_2026
# 生成方式：node -e "require('bcryptjs').hash('你的密码',10).then(console.log)"
# ADMIN_PASSWORD_HASH=$2b$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== JWT ====================
# 必须为至少 32 位的随机字符串，可用 openssl rand -hex 32 生成
JWT_SECRET=please-replace-with-a-random-64-hex-string
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_SECRET=please-replace-with-another-random-64-hex-string
REFRESH_TOKEN_EXPIRES_IN=7d

# ==================== 跨域白名单 ====================
# 逗号分隔；仅浏览器跨域需要，同源与小程序请求不受影响
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================== 上传 ====================
UPLOAD_MAX_MB=5

# ==================== 限流（每分钟每 IP） ====================
GLOBAL_RATE_LIMIT=600
LOGIN_RATE_LIMIT=5
INQUIRY_RATE_LIMIT=10

# ==================== 数据库（可选） ====================
# DB_PATH=./parts.db
